pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup Environment') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'project-env',
                        variable: 'ENV_FILE'
                    )
                ]) {
                    bat 'copy /Y "%ENV_FILE%" ".env"'
                }
            }
        }

        stage('Run Tests') {
            steps {
                bat 'mvn clean test'
            }
        }
    }

    post {

        always {

            // Store screenshots and other report files
            archiveArtifacts(
                artifacts: 'reports/screenshots/**/*',
                allowEmptyArchive: true
            )

            // Publish Extent Report
            publishHTML([
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'reports',
                reportFiles: 'ExtentReport.html',
                reportName: 'Extent Report'
            ])

            // Publish Cucumber Report
            publishHTML([
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'reports',
                reportFiles: 'Cucumber.html',
                reportName: 'Cucumber Report'
            ])
        }

        success {
            echo 'Automation execution completed successfully.'
        }

        failure {
            echo 'Automation execution failed. Check the reports and screenshots.'
        }
    }
}