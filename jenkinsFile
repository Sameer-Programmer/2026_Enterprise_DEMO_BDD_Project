pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Run Tests') {
            steps {
                bat 'mvn clean test'
            }
        }
    }

    post {

        always {
            archiveArtifacts artifacts: 'reports/**/*',
                             allowEmptyArchive: true
        }

        success {
            echo 'Automation execution completed successfully.'
        }

        failure {
            echo 'Automation execution failed. Check the reports and screenshots.'
        }
    }
}